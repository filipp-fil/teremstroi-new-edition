# ===================== СЕРВЕРНЫЕ ПЕРЕМЕННЫЕ (не попадают в браузер) =====================

# Пароль для входа в админку /admin/login (ОБЯЗАТЕЛЬНО поменяйте после деплоя)
ADMIN_PASSWORD=KLIK4231

# Секрет для подписи admin-cookie. Сгенерируйте случайную строку, например:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=замените_на_случайную_длинную_строку

# База данных SQLite (файл prisma/dev.db)
DATABASE_URL="file:./dev.db"

# SMTP для отправки заявок на почту fhockeyboy20@yahoo.com
# Пример для Яндекс.Почты: smtp.yandex.ru, порт 465, user — ваш ящик, pass — ПАРОЛЬ ПРИЛОЖЕНИЯ (не от почты!)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=ваш_ящер@yandex.ru
SMTP_PASS=пароль_приложения
MAIL_TO=fhockeyboy20@yahoo.com

# ===================== ПУБЛИЧНЫЕ ПЕРЕМЕННЫЕ (видны в браузере, префикс NEXT_PUBLIC_) =====================

# ID счётчика Яндекс.Метрики (только цифры). Если пусто — счётчик не грузится.
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Публичный адрес сайта (для sitemap.xml и канонических ссылок).
# Локально: http://localhost:7100  На проде: https://ваш-домен.ru
NEXT_PUBLIC_SITE_URL=http://localhost:7100
